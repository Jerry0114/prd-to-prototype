{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype.local/schemas/page-map.schema.json",
  "title": "原型页面地图",
  "type": "object",
  "required": ["schemaVersion", "projectId", "requirementsPath", "confirmation", "pages", "navigation", "connections", "uncoveredRequirements"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projectId": { "type": "string" },
    "requirementsPath": { "type": "string" },
    "requirementsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "confirmation": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["draft", "needs-confirmation", "confirmed"] },
        "confirmedBy": { "enum": ["user"] },
        "evidence": { "type": "string" },
        "confirmedAt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "module", "kind", "requirementRefs", "states", "implementationStatus", "reason"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "module": { "type": "string" },
          "kind": { "enum": ["web", "mobile"] },
          "parentPageId": { "type": ["string", "null"] },
          "requirementRefs": { "type": "array", "items": { "type": "string" } },
          "states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "implementationStatus": { "enum": ["built", "planned", "deferred", "blocked"] },
          "targetVersion": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "navigation": { "type": "array", "items": { "$ref": "#/$defs/navigationNode" } },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "trigger", "requirementRefs"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "trigger": { "type": "string" },
          "requirementRefs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "uncoveredRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirementId", "reason", "disposition"],
        "properties": {
          "requirementId": { "type": "string" },
          "reason": { "type": "string" },
          "disposition": { "enum": ["deferred", "blocked", "out-of-scope", "covered-by-rule"] }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "navigationNode": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["folder", "page"] },
        "title": { "type": "string" },
        "pageId": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/navigationNode" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
