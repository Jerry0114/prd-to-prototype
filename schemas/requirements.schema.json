{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype.local/schemas/requirements.schema.json",
  "title": "PRD 需求模型",
  "type": "object",
  "required": ["schemaVersion", "projectId", "sourceDocuments", "requirements", "openQuestions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "title"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "title": { "type": "string" },
          "version": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "impact"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "impact": { "type": "string" },
          "requirementRefs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["documentId", "startLine", "endLine", "quote"],
      "properties": {
        "documentId": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["id", "title", "type", "statement", "sourceRefs", "classification", "confidence", "confirmationStatus", "priority", "prototypeCritical"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
        "title": { "type": "string" },
        "type": { "enum": ["page", "field", "interaction", "rule", "state", "permission", "non-goal", "acceptance", "integration"] },
        "statement": { "type": "string" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "classification": { "enum": ["explicit", "inferred", "proposed", "unresolved"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmationStatus": { "enum": ["confirmed", "needs-confirmation", "rejected"] },
        "priority": { "enum": ["P0", "P1", "P2", "none"] },
        "prototypeCritical": { "type": "boolean" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "businessObjects": { "type": "array", "items": { "type": "string" } },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array", "items": { "type": "string" } },
        "exceptions": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
