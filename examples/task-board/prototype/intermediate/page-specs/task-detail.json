    "任务信息",
    "任务操作"
  ],
  "sections": [
    {
      "id": "detail",
      "title": "任务信息",
      "component": "section",
      "contentRule": "按传入任务 ID 展示标题、说明、负责人代号、截止日期和进度。"
    },
    {
      "id": "actions",
      "title": "任务操作",
      "component": "section",
      "contentRule": "提供完成与返回操作及其禁用与失败反馈。"
    }
  ],
  "fields": [
    {
      "id": "task-data",
      "label": "任务信息",
      "controlType": "display",
      "dataRule": "按 URL 的 id 查找当前会话任务，未知 ID 展示空态。",
      "requirementRefs": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004"
      ],
      "moduleId": "detail"
    }
  ],
  "actions": [
    {
      "id": "complete",
      "label": "标记完成",
      "trigger": "点击标记完成",
      "result": "更新为已完成并保存会话",
      "targetPageId": null,
      "failure": "保存失败提示当前页结果未保存",
      "logic": [
        "只将选中任务状态设为 done；重复操作保持相同结果；页面同步更新按钮和状态。"
      ],
      "requirementRefs": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004"
      ],
      "moduleId": "actions"
    },
    {
      "id": "back",
      "label": "返回列表",
      "trigger": "点击返回列表",
      "result": "返回列表并恢复筛选条件",
      "targetPageId": "task-list",
      "failure": "可通过左侧页面树返回",
      "logic": [
        "从会话读取上次筛选；无记录时使用全部进度和空关键词。"
      ],
      "requirementRefs": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004"
      ],
      "moduleId": "actions"
    }
  ],
  "states": [
    {
      "id": "normal",
      "applicable": true,
      "description": "展示当前任务信息和可执行操作。"
    },
    {
      "id": "loading",
      "applicable": true,
      "description": "任务信息区域显示加载提示；完成按钮禁用，返回列表仍可用。"
    },
    {
      "id": "empty",
      "applicable": true,
      "description": "任务 ID 不存在时显示找不到任务，禁用完成操作；仍可返回列表。"
    },
    {
      "id": "error",
      "applicable": true,
      "description": "任务信息区域显示失败和重试入口，完成按钮禁用；重试后按当前 ID 展示任务。"
    },
    {
      "id": "forbidden",
      "applicable": false,
      "description": "本样例无权限模型"
    },
    {
      "id": "expired",
      "applicable": false,
      "description": "本样例无过期业务"
    }
  ],
