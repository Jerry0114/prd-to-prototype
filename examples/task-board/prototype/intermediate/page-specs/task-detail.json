{
  "schemaVersion": "1.0",
  "projectId": "task-board-demo",
  "pageId": "task-detail",
  "title": "任务详情",
  "purpose": "查看任务详情、标记完成，并返回原筛选结果。",
  "requirementRefs": [
    "REQ-001",
    "REQ-002",
    "REQ-003",
    "REQ-004"
