  "annotations": [
    {
      "id": "task-list-note-1",
      "title": "筛选区",
      "scope": "module",
      "moduleId": "filters",
      "content": "模块定义\n查找当前任务。\n\n展示内容\n关键词输入、进度选择。\n\n数据规则\n数据完全虚构，使用本地会话保存；关键词匹配标题并与进度筛选同时生效。\n\n交互逻辑\n点击标题传递任务 ID；标记完成更新会话；返回后保留查询条件。\n\n异常与状态\n加载中显示进度提示；无结果显示空态；错误允许重试；没有权限与过期场景。\n\n关联文档\ndocs/PRD.md",
      "requirementRefs": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004"
      ],
      "covers": [
        "section:filters",
        "field:keyword",
        "field:status"
      ],
      "anchor": {
        "anchorId": "filters",
        "offset": {
          "x": 8,
          "y": 8
        },
        "fallback": {
          "x": 8,
          "y": 25,
          "coordinateSpace": "reference-viewport-percent"
        },
        "bindingStatus": "bound"
      }
    },
    {
      "id": "task-list-note-2",
      "title": "任务列表",
      "scope": "module",
      "moduleId": "tasks",
      "content": "模块定义\n呈现任务信息与操作。\n\n展示内容\n任务标题、说明、成员代号、日期和进度；操作按页面提供查看、返回或完成。\n\n数据规则\n数据完全虚构，使用本地会话保存；关键词匹配标题并与进度筛选同时生效。\n\n交互逻辑\n点击标题传递任务 ID；标记完成更新会话；返回后保留查询条件。\n\n异常与状态\n加载中显示进度提示；无结果显示空态；错误允许重试；没有权限与过期场景。\n\n关联文档\ndocs/PRD.md",
      "requirementRefs": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004"
      ],
      "covers": [
        "section:tasks",
        "action:open",
        "state:normal",
        "state:loading",
        "state:empty",
        "state:error"
      ],
